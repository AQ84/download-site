# Cloudflare Pages 自定义 HTTP 头
# 静态资源长期缓存
/style.css
  Cache-Control: public, max-age=86400

/app.js
  Cache-Control: public, max-age=86400

# 下载文件短期缓存
/files/*
  Cache-Control: public, max-age=3600
  Content-Disposition: attachment

# 索引接口: 绝对不能缓存 —— 管理员改完要立刻看到, 而且带密钥的写请求更不该进缓存
/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff

# 管理页: 别让搜索引擎收录。
# 注意路径写 /admin* 而不是 /admin.html —— Cloudflare Pages 默认会把
# /xxx.html 规范化重定向成 /xxx(308), 真正的路径是 /admin。
/admin*
  X-Robots-Tag: noindex, nofollow
